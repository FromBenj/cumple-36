<div id="section-{{id}}" class="section-intro section">
    <img id="palm-trees-img" src="/images/palm-trees.jpg" alt="Palm trees">
    <div id="section-intro-blanket-message">
        <h2 class="text-italic">Primero</h2>
        <h1 class="fw-bold">Elige tu mantel de picnic</h1>
    </div>
    <div id="section-intro-blanket-footer">
        <img class="to-next-section-icon to-first-section" src="/icons/down.svg" alt="Next section button" data-id="{{id}}" data-type="{{type}}">
    </div>
</div>