<div id="section-{{id}}" class="section">
    <div class="section-header">
        <div class="modelo-title-container">
            <h2 class="modelo-title"> - Modelo {{position}}, rótate - </h2>
        </div>
    </div>
    <div class="section-body">
        <div class="section-title-container">
            <div class="section-title">{{title}}</div>
        </div>
        <div id="{{swiperId}}" class="swiper">
            <div class="swiper-wrapper">
                {{#images}}
                    <div class="swiper-slide"><img src="{{.}}" alt="Product slide"></div>
                {{/images}}
            </div>
            <div class="swiper-pagination"></div>
        </div>
        <div class="product-characteristics">
            {{#dimensions}}
                <div class="container-center py-2">
                    <div class="product-characteristic-title">Dimensions :</div>
                    <div class="text-center w-100 pt-2">{{dimensions}}</div>
                </div>
            {{/dimensions}}
            {{#presentation}}
                <div class="container-center py-2">
                    <div class="product-characteristic-title">Présentation :</div>
                    <div class="text-center w-100 pt-2">{{presentation}}</div>
                </div>
            {{/presentation}}
            {{#advice}}
                <div class="container-center py-2">
                    <div class="product-characteristic-title">Conseil :</div>
                    <div class="text-center w-100 pt-2">{{advice}}</div>
                </div>
            {{/advice}}
        </div>
    </div>
    <div class="section-footer">
        <img class="to-next-section-icon" src="/icons/down.svg" alt="Next section button" data-id="section-{{id}}">
        <img class="to-last-section-icon" src="/icons/up.svg" alt="Next section button" data-id="section-{{id}}">
    </div>
</div>