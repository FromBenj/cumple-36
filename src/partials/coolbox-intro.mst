<div id="section-{{id}}" class="section-intro section">
    <img id="fresh-img" src="/images/fresh.jpg" alt="Fresh image">
    <div id="section-intro-coolbox-message">
        <h3 class="text-italic">Segundo</h3>
        <h2 class="fw-bold">Elige tu nevera</h2>
    </div>
    <div id="section-intro-coolbox-footer">
        <div class="to-last-section d-none"></div>
        <div class="section-blanket-button d-none"></div>
        <div class="section-coolbox-button d-none"></div>
        <img class="to-next-section to-first-section" src="/icons/down.svg" alt="Next section button" data-id="{{id}}"
             data-type="{{type}}">
    </div>
</div>